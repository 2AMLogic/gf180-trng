  let m_sigma_startup16_8 = sqrt(mean(s8*s8)/(1 - 8/16))
  let m_i_ring_a = -cq*(qw1-qw0)/(tc[768]-tc[256])
  let m_p_active_w = -cq*(qw1-qw0)/(tc[768]-tc[256])*mean(v(vsup))
  let m_e_per_cycle_j = -cq*(qw1-qw0)/512*mean(v(vsup))
  let m_c_eff_node_f = -cq*(qw1-qw0)/(512*nstg*mean(v(vsup)))
  let m_vsup_v = mean(v(vsup))
