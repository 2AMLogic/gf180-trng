.control
set numdgt=10
set noaskquit
  save x1 q1 vsup
  tran 1p 2.400003u
  let cq = 1e-9
  let nstg = 5
  let tc = vector(769)
  let k = 0
  while k < 769
    let ri = k + 2
    meas tran tk when v(x1)=0 rise=$&ri
    let tc[k] = tk
    let k = k + 1
  end
  meas tran qw0 find v(q1) when v(x1)=0 rise=258
  meas tran qw1 find v(q1) when v(x1)=0 rise=770
  let tbar = (tc[768] - tc[256])/512
  let tbars = (tc[16] - tc[0])/16
  let r1 = (tc[257,768] - tc[256,767]) - 1*tbar
  let r2 = (tc[258,768] - tc[256,766]) - 2*tbar
  let r4 = (tc[260,768] - tc[256,764]) - 4*tbar
  let r8 = (tc[264,768] - tc[256,760]) - 8*tbar
  let r16 = (tc[272,768] - tc[256,752]) - 16*tbar
  let r32 = (tc[288,768] - tc[256,736]) - 32*tbar
  let r64 = (tc[320,768] - tc[256,704]) - 64*tbar
  let r128 = (tc[384,768] - tc[256,640]) - 128*tbar
  let s1 = (tc[1,16] - tc[0,15]) - 1*tbars
  let s2 = (tc[2,16] - tc[0,14]) - 2*tbars
  let s4 = (tc[4,16] - tc[0,12]) - 4*tbars
  let s8 = (tc[8,16] - tc[0,8]) - 8*tbars
  let m_period = tbar
  let m_f_osc = 1/tbar
  let m_period_startup16 = tbars
  let m_period_b00 = (tc[48] - tc[0])/48
  let m_period_b01 = (tc[96] - tc[48])/48
  let m_period_b02 = (tc[144] - tc[96])/48
  let m_period_b03 = (tc[192] - tc[144])/48
  let m_period_b04 = (tc[240] - tc[192])/48
  let m_period_b05 = (tc[288] - tc[240])/48
  let m_period_b06 = (tc[336] - tc[288])/48
  let m_period_b07 = (tc[384] - tc[336])/48
  let m_period_b08 = (tc[432] - tc[384])/48
