  let m_period_b10 = (tc[528] - tc[480])/48
  let m_period_b11 = (tc[576] - tc[528])/48
  let m_period_b12 = (tc[624] - tc[576])/48
  let m_period_b13 = (tc[672] - tc[624])/48
  let m_period_b14 = (tc[720] - tc[672])/48
  let m_period_b15 = (tc[768] - tc[720])/48
  let m_sigma_1 = sqrt(mean(r1*r1)/(1 - 1/512))
  let m_sigma_2 = sqrt(mean(r2*r2)/(1 - 2/512))
  let m_sigma_4 = sqrt(mean(r4*r4)/(1 - 4/512))
  let m_sigma_8 = sqrt(mean(r8*r8)/(1 - 8/512))
  let m_sigma_16 = sqrt(mean(r16*r16)/(1 - 16/512))
  let m_sigma_32 = sqrt(mean(r32*r32)/(1 - 32/512))
  let m_sigma_64 = sqrt(mean(r64*r64)/(1 - 64/512))
  let m_sigma_128 = sqrt(mean(r128*r128)/(1 - 128/512))
  let m_sigma_startup16_1 = sqrt(mean(s1*s1)/(1 - 1/16))
  let m_sigma_startup16_2 = sqrt(mean(s2*s2)/(1 - 2/16))
