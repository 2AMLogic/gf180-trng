  let m_tau_100p_10p_s = (tq5-tq6)/ln10
  let m_tau_10p_1p_s = (tq4-tq5)/ln10
  let m_tau_1p_100f_s = (tq3-tq4)/ln10
  let m_tau_100f_10f_s = (tq2-tq3)/ln10
  let m_tau_10f_1f_s = (tq1-tq2)/ln10
  let m_v_q0_bal_v = vq0
  let m_v_qn0_bal_v = vqn0
  let m_v_diff_bal_v = abs(vq0-vqn0)
  print m_t_res_100p_s
