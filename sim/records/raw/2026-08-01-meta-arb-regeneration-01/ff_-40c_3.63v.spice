  print m_t_res_1p_s
  print m_t_res_100f_s
  print m_t_res_10f_s
  print m_t_res_1f_s
  print m_tau_100p_10p_s
  print m_tau_10p_1p_s
  print m_tau_1p_100f_s
  print m_tau_100f_10f_s
  print m_tau_10f_1f_s
  print m_v_q0_bal_v
  print m_v_qn0_bal_v
  print m_v_diff_bal_v
