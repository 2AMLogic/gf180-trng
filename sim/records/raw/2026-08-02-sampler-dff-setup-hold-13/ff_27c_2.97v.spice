  let m_q_e3_1ns_v = q_e3a
  let m_q_e3_10ns_v = q_e3b
  let m_q_e3_100ns_v = q_e3c
  let m_q_e3_drift_v = q_e3c-q_e3a
  let m_q_e3_rail_dev_v = vhalf-abs(q_e3c-vhalf)
  let m_q_e5_1ns_v = q_e5a
  let m_q_e5_10ns_v = q_e5b
  let m_q_e5_100ns_v = q_e5c
  let m_q_e5_drift_v = q_e5c-q_e5a
  let m_q_e5_rail_dev_v = vhalf-abs(q_e5c-vhalf)
  let m_q_e6_v = q_e6
  let m_q_e7_1ns_v = q_e7a
  let m_q_e7_10ns_v = q_e7b
  let m_q_e7_100ns_v = q_e7c
  let m_q_e7_drift_v = q_e7c-q_e7a
  let m_q_e7_rail_dev_v = vhalf-abs(q_e7c-vhalf)
  print m_tpd_clk_q_rise_s
