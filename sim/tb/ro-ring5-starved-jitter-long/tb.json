{
  "name": "ro-ring5-starved-jitter-long",
  "description": "One 5-stage ring of the SHIPPED starved delay cell (design/xschem/ro_stage.sch), transient noise, with the measurement window opened 256 periods after start-up and spanning 512 periods, so jitter accumulation can be fitted over lags 1..128 (2.11 decades). Sixteen per-block mean periods across the whole run make the start-up settling visible in the record itself; the 16-period start-up-window figures reproduce, in the SAME run, the measurement that sim/records/2026-08-01-ro-array-sanity-jitter-01.md made.",
  "netlist": "tb_ro_ring5_starved_jitter_long.sp",
  "design_netlist": "design/ro_array_sanity.spice",
  "analysis_type": "tran-noise",
  "corners": [
    "tt",
    "ss",
    "ff"
  ],
  "default_runs": 8,
  "params": {
    "vn_rms": "2.2361e-3",
    "vn_dt": "1e-11"
  },
  "tstop": "2.4u",
  "tstep": "1p (print step; ngspice's own LTE and the trnoise breakpoints at vn_dt set the actual solver step -- measured 1.3 solver points per ps of simulated time at tt/27 C/3.30 V)",
  "noise_params": "per-stage trnoise( NA=2.2361e-3 NT=1e-11 NALPHA=0 NAMP=0 ) -> injected white PSD 1e-16 V^2/Hz (1e-08 V/sqrt(Hz)), 5 sources, one in series with every stage input",
  "analyses": [
    "save x1 q1 vsup",
    "tran 1p 2.4u",
    "let cq = 1e-9",
    "let nstg = 5",
    "let tc = vector(769)",
    "let k = 0",
    "while k < 769",
    "  let ri = k + 2",
    "  meas tran tk when v(x1)=0 rise=$&ri",
    "  let tc[k] = tk",
    "  let k = k + 1",
    "end",
    "meas tran qw0 find v(q1) when v(x1)=0 rise=258",
    "meas tran qw1 find v(q1) when v(x1)=0 rise=770",
    "let tbar = (tc[768] - tc[256])/512",
    "let tbars = (tc[16] - tc[0])/16",
    "let r1 = (tc[257,768] - tc[256,767]) - 1*tbar",
    "let r2 = (tc[258,768] - tc[256,766]) - 2*tbar",
    "let r4 = (tc[260,768] - tc[256,764]) - 4*tbar",
    "let r8 = (tc[264,768] - tc[256,760]) - 8*tbar",
    "let r16 = (tc[272,768] - tc[256,752]) - 16*tbar",
    "let r32 = (tc[288,768] - tc[256,736]) - 32*tbar",
    "let r64 = (tc[320,768] - tc[256,704]) - 64*tbar",
    "let r128 = (tc[384,768] - tc[256,640]) - 128*tbar",
    "let s1 = (tc[1,16] - tc[0,15]) - 1*tbars",
    "let s2 = (tc[2,16] - tc[0,14]) - 2*tbars",
    "let s4 = (tc[4,16] - tc[0,12]) - 4*tbars",
    "let s8 = (tc[8,16] - tc[0,8]) - 8*tbars"
  ],
  "measure": {
    "period": "tbar",
    "f_osc": "1/tbar",
    "period_startup16": "tbars",
    "period_b00": "(tc[48] - tc[0])/48",
    "period_b01": "(tc[96] - tc[48])/48",
    "period_b02": "(tc[144] - tc[96])/48",
    "period_b03": "(tc[192] - tc[144])/48",
    "period_b04": "(tc[240] - tc[192])/48",
    "period_b05": "(tc[288] - tc[240])/48",
    "period_b06": "(tc[336] - tc[288])/48",
    "period_b07": "(tc[384] - tc[336])/48",
    "period_b08": "(tc[432] - tc[384])/48",
    "period_b09": "(tc[480] - tc[432])/48",
    "period_b10": "(tc[528] - tc[480])/48",
    "period_b11": "(tc[576] - tc[528])/48",
    "period_b12": "(tc[624] - tc[576])/48",
    "period_b13": "(tc[672] - tc[624])/48",
    "period_b14": "(tc[720] - tc[672])/48",
    "period_b15": "(tc[768] - tc[720])/48",
    "sigma_1": "sqrt(mean(r1*r1)/(1 - 1/512))",
    "sigma_2": "sqrt(mean(r2*r2)/(1 - 2/512))",
    "sigma_4": "sqrt(mean(r4*r4)/(1 - 4/512))",
    "sigma_8": "sqrt(mean(r8*r8)/(1 - 8/512))",
    "sigma_16": "sqrt(mean(r16*r16)/(1 - 16/512))",
    "sigma_32": "sqrt(mean(r32*r32)/(1 - 32/512))",
    "sigma_64": "sqrt(mean(r64*r64)/(1 - 64/512))",
    "sigma_128": "sqrt(mean(r128*r128)/(1 - 128/512))",
    "sigma_startup16_1": "sqrt(mean(s1*s1)/(1 - 1/16))",
    "sigma_startup16_2": "sqrt(mean(s2*s2)/(1 - 2/16))",
    "sigma_startup16_4": "sqrt(mean(s4*s4)/(1 - 4/16))",
    "sigma_startup16_8": "sqrt(mean(s8*s8)/(1 - 8/16))",
    "i_ring_a": "-cq*(qw1-qw0)/(tc[768]-tc[256])",
    "p_active_w": "-cq*(qw1-qw0)/(tc[768]-tc[256])*mean(v(vsup))",
    "e_per_cycle_j": "-cq*(qw1-qw0)/512*mean(v(vsup))",
    "c_eff_node_f": "-cq*(qw1-qw0)/(512*nstg*mean(v(vsup)))",
    "vsup_v": "mean(v(vsup))"
  }
}
