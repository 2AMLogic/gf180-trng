{
  "netlist": "tb_ro_ring11_pex.sp",
  "engine": "ngspice",
  "models": { "pdk": "gf180mcuD", "lib": "libs.tech/ngspice/sm141064.ngspice" },
  "corners": {
    "process": [
      { "name": "tt", "sections": ["typical", "bjt_typical", "diode_typical", "res_typical", "moscap_typical", "mimcap_typical"] },
      { "name": "ff", "sections": ["ff", "bjt_ff", "diode_ff", "res_ff", "moscap_ff", "mimcap_ff"] },
      { "name": "ss", "sections": ["ss", "bjt_ss", "diode_ss", "res_ss", "moscap_ss", "mimcap_ss"] }
    ],
    "supply_v": { "vsupply": [2.97, 3.3, 3.63] },
    "temperature_c": [-40, 27, 125]
  },
  "analysis": { "kind": "tran", "args": "10p 1300n" },
  "measurements": [
    {
      "name": "period_s",
      "spice": ".meas tran period_s trig v(ron) val=0.5 rise=10 targ v(ron) val=0.5 rise=11",
      "unit": "s"
    },
    {
      "name": "supply_current_avg_a",
      "spice": ".meas tran supply_current_avg_a avg i(vsupply) from=300n to=1300n",
      "unit": "A"
    },
    {
      "name": "ro_swing_v",
      "spice": ".meas tran ro_swing_v pp v(ro) from=300n to=1300n",
      "unit": "V"
    }
  ],
  "options": { "timeout_s": 600, "keep_artifacts": false, "waveforms": false }
}
