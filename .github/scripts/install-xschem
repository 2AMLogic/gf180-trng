#!/usr/bin/env bash
# install-xschem -- credential-free install of the fleet-pinned xschem for CI
# (issue #991; fleet-wide ask is 2am#7275, following the sg13g2-lna pilot,
# sg13g2-lna#259).
#
#   .github/scripts/install-xschem           # build + install + verify
#   .github/scripts/install-xschem --check   # verify an existing install only
#
# WHY NOT APT. Ubuntu noble's archive ships xschem 3.4.4, and this repo's
# netlist pin is the fleet's one xschem version, 3.4.7 (2am#7275; this
# migration is issue #991, filed from the batched follow-up 2am#7326). CI
# holds no infra credentials, so a source build of the pinned tag from the
# upstream public repo is the interim route. When klayout-tools#6219 ships
# the pinned build as a public release asset with its sha256 recorded beside
# the pin (the master pin is 2AMLogic/klayout-tools docker/eda-sim/
# pdk-versions.json, tools.xschem), this script becomes a download plus
# digest check.
#
# THE PINS. pdk-nightly.yml's job env carries XSCHEM_VERSION / XSCHEM_COMMIT
# and exports XSCHEM_PREFIX; this script defaults to the same values so it
# also runs standalone. XSCHEM_COMMIT must be the commit the XSCHEM_VERSION
# tag resolves to -- asserted below before anything is built, so a moved or
# retagged upstream fails loudly instead of silently drifting. A pin bump
# lands in klayout-tools first, then here -- grep XSCHEM_COMMIT when bumping.
#
# The build lands under "${XSCHEM_PREFIX}" (default: "$RUNNER_TEMP/xschem";
# the workflow pins it to ~/.local/xschem-<version> so actions/cache can
# hold it, keyed on the version and the commit) -- a plain local prefix, no
# root needed -- and the bin dir is exported to GITHUB_PATH so later steps
# resolve `xschem` to it. Runtime libraries are apt's tcl/tk/X11 stack,
# which ubuntu-latest images carry; the -dev packages below are build-time
# only.
#
# A headless netlist smoke follows the build, because xschem's CLI exits
# non-zero on a successful -x run -- the verdict is the output file, and
# proving that once per runner beats debugging it inside
# `design/netlist.py --check`. Bounded by `timeout` either way.
#
# The smoke passes an explicit --rcfile: xschem resolves the stock
# `devices/*.sym` symbols through XSCHEM_LIBRARY_PATH, whose default is
# baked in at configure time, so a relocated build finds no symbols without
# one. This mirrors the route the repo's own netlisting takes
# (design/netlist.py generates and passes an rc file of its own).
set -euo pipefail

XSCHEM_REPO="https://github.com/StefanSchippers/xschem"
XSCHEM_TAG="${XSCHEM_VERSION:-3.4.7}"
XSCHEM_COMMIT="${XSCHEM_COMMIT:-92dd8fe5f4d5c1057489710d8a22f18fdc9d7ed0}"
PREFIX="${XSCHEM_PREFIX:-${RUNNER_TEMP:-${TMPDIR:-/tmp}}/xschem}"

die() { echo "install-xschem: $1" >&2; exit 1; }

version_of() { "$1" --version 2>&1 | grep -oE 'XSCHEM V[0-9]+\.[0-9]+\.[0-9]+' | head -n 1; }

if [ "${1:-}" = "--check" ]; then
  command -v xschem >/dev/null 2>&1 || die "no xschem on PATH"
  got="$(version_of xschem)" || die "cannot read xschem --version"
  [ "$got" = "XSCHEM V${XSCHEM_TAG}" ] \
    || die "xschem is ${got:-unknown}, want XSCHEM V${XSCHEM_TAG}"
  echo "install-xschem: ok ($got)"
  exit 0
fi

[ "$(version_of "${PREFIX}/bin/xschem" 2>/dev/null || true)" = "XSCHEM V${XSCHEM_TAG}" ] && {
  echo "install-xschem: ${PREFIX} already has xschem ${XSCHEM_TAG}; skipping the build"
  exit 0
}

export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -qq
sudo apt-get install -y --no-install-recommends \
  ca-certificates git build-essential bison flex gawk \
  libcairo2-dev libx11-dev libxcb1-dev libxpm-dev libxrender-dev \
  tcl-dev tk-dev >/dev/null

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
git clone -q --depth 1 --branch "$XSCHEM_TAG" "$XSCHEM_REPO" "$work/xschem"
got="$(git -C "$work/xschem" rev-parse HEAD)"
[ "$got" = "$XSCHEM_COMMIT" ] \
  || die "tag ${XSCHEM_TAG} resolved to ${got}, pinned to ${XSCHEM_COMMIT}"

(cd "$work/xschem" && ./configure --prefix="$PREFIX" >/dev/null)
make -C "$work/xschem" -s -j"$(nproc)" >/dev/null
make -C "$work/xschem" -s install >/dev/null

got="$(version_of "${PREFIX}/bin/xschem")" || die "built xschem reports no version"
[ "$got" = "XSCHEM V${XSCHEM_TAG}" ] || die "built xschem is ${got}, want XSCHEM V${XSCHEM_TAG}"

# Headless netlist smoke: -x keeps xschem from starting Tk; the exit status
# is non-zero on success, so the verdict is the output file (the same probe
# the fleet's build recipe runs).
smoke="$work/smoke"
mkdir -p "$smoke/netlist"
printf '%s\n' \
  'set XSCHEM_LIBRARY_PATH {}' \
  'append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library' \
  'append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices' \
  > "$smoke/rc"
printf '%s\n' \
  'v {xschem version=3.4.7 file_version=1.2}' \
  'C {devices/res.sym} 0 0 0 0 {name=R1 value=1k}' \
  'C {devices/lab_pin.sym} 0 -30 0 0 {name=p1 lab=a}' \
  'C {devices/lab_pin.sym} 0 30 0 0 {name=p2 lab=0}' > "$smoke/t.sch"
HOME="$smoke" timeout -k 5 60 "${PREFIX}/bin/xschem" -n -s -q -x -r \
  --rcfile "$smoke/rc" -o "$smoke/netlist" "$smoke/t.sch" >"$smoke/log" 2>&1 || true
grep -qE '^R1 ' "$smoke/netlist/t.spice" \
  || die "headless netlist smoke failed ($(tail -n 5 "$smoke/log" "$smoke/netlist/t.spice" 2>/dev/null | tr '\n' ' '))"

if [ -n "${GITHUB_PATH:-}" ] && [ -n "${CI:-}" ]; then
  echo "${PREFIX}/bin" >> "$GITHUB_PATH"
else
  echo "install-xschem: add ${PREFIX}/bin to PATH to use it" >&2
fi
echo "install-xschem: built ${got} at ${PREFIX} (commit ${XSCHEM_COMMIT})"
